# Copy this file to ".env" (same folder as docker-compose.yml) and adjust if needed.
# ".env" must NEVER be committed to git. This example file is safe to commit.

# --- PostgreSQL (used by docker-compose.yml) ---
POSTGRES_DB=roommate_db
POSTGRES_USER=roommate_user
POSTGRES_PASSWORD=change_me
# Change only if something else already uses 5432 on your machine
# (e.g. a locally installed PostgreSQL). If you change it, update DB_URL below too.
POSTGRES_PORT=5432

# --- pgAdmin (optional, started with: docker compose --profile tools up -d) ---
PGADMIN_EMAIL=admin@roommate.dev
PGADMIN_PASSWORD=admin

# --- Spring Boot (read by application.yml via ${...} placeholders) ---
# These defaults match the PostgreSQL values above.
DB_URL=jdbc:postgresql://localhost:5432/roommate_db
DB_USERNAME=roommate_user
DB_PASSWORD=change_me

# JWT signing secret. Must be at least 32 characters for HS256.
# Generate your own, e.g.: openssl rand -base64 48
JWT_SECRET=replace-this-with-a-long-random-secret-at-least-32-chars
# Token lifetime in milliseconds (86400000 = 24 hours)
JWT_EXPIRATION_MS=86400000
